NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-publishable-or-anon-key

# Service role key: Project Settings -> API Keys -> "service_role" (secret).
# Server-only. Never expose this to the browser (no NEXT_PUBLIC_ prefix).
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Cloudflare Turnstile (CAPTCHA) keys: dash.cloudflare.com -> Turnstile
NEXT_PUBLIC_TURNSTILE_SITE_KEY=your-turnstile-site-key
TURNSTILE_SECRET_KEY=your-turnstile-secret-key

# Stripe: dashboard.stripe.com -> Developers -> API keys / Product catalogue
STRIPE_SECRET_KEY=your-stripe-secret-key
STRIPE_PRICE_MONTHLY=price-id-for-the-monthly-plan
STRIPE_PRICE_YEARLY=price-id-for-the-yearly-plan
# Created after adding a webhook endpoint: Developers -> Webhooks -> Signing secret
STRIPE_WEBHOOK_SECRET=your-webhook-signing-secret

# Comma-separated list of emails allowed into /admin (the hidden admin dashboard)
ADMIN_EMAILS=you@example.com,cofounder@example.com
